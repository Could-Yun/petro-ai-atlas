  "tabs": {
    "background": {
      "label": "专业背景",
      "judge": [
        {
          "label": "任务类型",
          "value": "波形序列标注",
          "desc": "逐采样点判断\"到了没有\"，找到达时刻"
        },
        {
          "label": "数据门槛",
          "value": "5%—10% 的道",
          "desc": "人工拾取，且覆盖低信噪比道"
