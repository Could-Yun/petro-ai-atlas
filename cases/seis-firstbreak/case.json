        {
          "label": "收益",
          "value": "数人月 → 1 周",
          "desc": "百万道三维工区（含复核）"
        },
        {
          "label": "难度",
          "value": "中",
          "desc": "低信噪比道与强干扰易误拾"
        }
      ],
      "lede": "初至是震源激发后最先到达检波器的波，它的到达时间用来计算近地表速度和静校正量。**初至拾错几毫秒，静校正就错几毫秒**——叠加剖面上的同相轴会抖动，甚至\"做\"出并不存在的构造。",
      "sections": [
        {
          "no": 1,
          "en": "PROBLEM",
          "title": "当前做法与问题",
          "html": "<p>常规做法是先用能量比等自动方法给出初值，再由处理员在炮集上逐道检查、修正。一个三维工区有百万级的地震道，拾取需要数人月。</p><p>问题集中在<b>低信噪比道</b>：远偏移距、表层复杂区的道，自动初值错得多，人工修正量大；<b>面波、折射等强能量干扰</b>会让自动方法提前或延后触发；修正标准因人而异，<b>返工率高</b>。</p><div class=\"figure\"><svg viewBox=\"0 0 620 260\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"初至人工修正的问题\"><rect x=\"20\" y=\"20\" width=\"580\" height=\"226\" fill=\"#fdfcf9\" stroke=\"#e9e4d8\"/><polyline points=\"60.0,40.4 65.2,39.4 70.4,39.7 75.6,40.1 80.8,39.6 86.0,40.0 91.2,40.1 96.4,39.7 101.6,39.5 106.8,40.1 112.0,40.4 117.2,39.7 122.4,39.9 127.6,40.7 132.8,39.8 138.0,39.8 143.2,41.0 148.4,39.4 153.6,40.3 158.8,39.2 164.0,39.8 169.2,43.1 174.4,43.3 179.6,37.4 184.8,34.4 190.0,38.5 195.2,43.9 200.4,45.0 205.6,39.9 210.8,34.2 216.0,36.4 221.2,43.1 226.4,44.7 231.6,41.2 236.8,35.8 242.0,36.6 247.2,41.4 252.4,43.9 257.6,41.9 262.8,36.5 268.0,36.9 273.2,40.3 278.4,43.8 283.6,42.0 288.8,37.9 294.0,37.3 299.2,39.5 304.4,43.2 309.6,42.6 314.8,40.3 320.0,37.2 325.2,38.2 330.4,42.1 335.6,42.7 340.8,39.2 346.0,37.6 351.2,38.6 356.4,41.3 361.6,42.2 366.8,40.2 372.0,38.5 377.2,37.6 382.4,40.8 387.6,41.9 392.8,40.8 398.0,38.7 403.2,37.8 408.4,39.5 413.6,41.2 418.8,41.2 424.0,39.6 429.2,38.6 434.4,38.9 439.6,40.7 444.8,41.2 450.0,40.0 455.2,38.7 460.4,38.3 465.6,41.3 470.8,40.9\" fill=\"none\" stroke=\"#565656\" stroke-width=\"1\"/><line x1=\"164.0\" y1=\"34\" x2=\"164.0\" y2=\"46\" stroke=\"#2f7d6b\" stroke-width=\"2\"/><circle cx=\"166.6\" cy=\"40\" r=\"3\" fill=\"#b26a39\"/><polyline points=\"60.0,56.9 65.2,57.0 70.4,56.0 75.6,55.5 80.8,55.3 86.0,56.0 91.2,55.3 96.4,55.0 101.6,56.1 106.8,56.1 112.0,56.4 117.2,55.4 122.4,56.0 127.6,56.0 132.8,55.0 138.0,56.4 143.2,56.2 148.4,57.6 153.6,56.1 158.8,55.9 164.0,56.8 169.2,56.1 174.4,56.6 179.6,55.8 184.8,56.1 190.0,57.6 195.2,59.9 200.4,56.7 205.6,50.7 210.8,52.0 216.0,57.8 221.2,62.1 226.4,58.4 231.6,53.0 236.8,51.1 242.0,56.3 247.2,61.2 252.4,58.4 257.6,53.5 262.8,51.1 268.0,56.2 273.2,59.5 278.4,60.0 283.6,55.6 288