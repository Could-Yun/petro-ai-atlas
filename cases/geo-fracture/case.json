      "judge": [
        {
          "label": "任务类型",
          "value": "实例分割 + 几何反算",
          "desc": "从照片里的裂缝到地质产状"
        },
        {
          "label": "数据门槛",
          "value": "≥ 1000 条裂缝掩膜",
